# ───────────────────────────────────────────────────────────────────────
# Elevate Control — environment variables
# Copy to `.env.local` and fill in. Never commit `.env.local`.
# ───────────────────────────────────────────────────────────────────────

# Supabase — public values (safe to expose in browser bundles)
NEXT_PUBLIC_SUPABASE_URL="https://siohhswzfuckkdhpuyop.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_..."

# Supabase — server-only secret (NEVER expose, NEVER commit)
# Used by API routes, Server Actions, and migrations. Bypasses RLS.
SUPABASE_SECRET_KEY=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Elevate Control"

# Auth — used by the magic-link redirect logic
NEXT_PUBLIC_AUTH_REDIRECT_URL="http://localhost:3000/auth/callback"

# Anthropic / Claude — for image analysis (Phase 3)
# Leave empty until we wire up the design-analysis feature
ANTHROPIC_API_KEY=""

# GitHub — for the optional Git sync feature
# Personal Access Token with `repo` scope
GITHUB_TOKEN=""
GITHUB_DEFAULT_OWNER=""
